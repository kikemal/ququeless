{
  "name": "queueless",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/unit/**/*.test.ts",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:status": "supabase status",
    "db:types": "node scripts/gen-db-types.mjs",
    "db:security-check": "supabase db query --local -f tests/integration/phase1_security_checks.sql",
    "db:behavior-check": "supabase db query --local -f tests/integration/phase1_behavior_checks.sql",
    "db:phase2-check": "supabase db query --local -f tests/integration/phase2_onboarding_checks.sql",
    "db:phase3-check": "supabase db query --local -f tests/integration/phase3_services_queues_checks.sql",
    "db:phase4-check": "supabase db query --local -f tests/integration/phase4_public_queue_checks.sql",
    "db:phase5b-check": "supabase db query --local -f tests/integration/phase5b_live_updates_checks.sql",
    "db:phase6-check": "supabase db query --local -f tests/integration/phase6_team_invitations_checks.sql"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.6",
    "@supabase/supabase-js": "^2.115.0",
    "next": "16.3.4",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "supabase": "^2.116.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
