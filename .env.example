NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-or-publishable-key

# Public app origin (browser-safe). Required in production for QR, invites,
# email confirmation redirects, and ticket links in notifications.
# Prefer NEXT_PUBLIC_APP_URL. NEXT_PUBLIC_SITE_URL is an accepted alias.
NEXT_PUBLIC_APP_URL=https://your-app.onrender.com
# NEXT_PUBLIC_SITE_URL=https://your-app.onrender.com

# ---------------------------------------------------------------------------
# Server-only secrets — never prefix with NEXT_PUBLIC_ and never ship to the browser.
# Browser-safe vars above may be NEXT_PUBLIC_*; everything below must stay server-only.
# ---------------------------------------------------------------------------
# SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# Phase 7 customer email notifications (optional).
# QUEUELESS_EMAIL_PROVIDER=console
# QUEUELESS_EMAIL_PROVIDER=resend
# RESEND_API_KEY=
# QUEUELESS_EMAIL_FROM=QueueLess <notifications@yourdomain.com>
# QUEUELESS_EMAIL_FORCE_FAIL=1
