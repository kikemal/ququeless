NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55001
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key

# Public app origin (browser-safe). Used for QR links, invite URLs, and auth redirects.
# Prefer NEXT_PUBLIC_APP_URL in production. NEXT_PUBLIC_SITE_URL is an accepted alias.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Server-only secrets — never prefix with NEXT_PUBLIC_ and never ship to the browser.
# ---------------------------------------------------------------------------
# SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key

# Phase 7 customer email notifications (optional).
# QUEUELESS_EMAIL_PROVIDER=console
# QUEUELESS_EMAIL_PROVIDER=resend
# RESEND_API_KEY=
# QUEUELESS_EMAIL_FROM=QueueLess <notifications@yourdomain.com>
# QUEUELESS_EMAIL_FORCE_FAIL=1
